<section class="password-page">
  <div class="wrap wrap--narrow password-page__inner">
    <span class="site-logo__mark">{{ shop.name | slice: 0, 1 }}</span>
    <h1>{{ shop.name }}</h1>
    <p>This store isn't open to the public yet.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}<p class="form-error">Wrong password, try again.</p>{% endif %}
      <input type="password" name="password" placeholder="Enter store password">
      <button type="submit" class="btn btn--primary btn--full">Enter</button>
    {% endform %}
  </div>
</section>
