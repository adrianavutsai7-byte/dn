<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root{
      --bg: {{ settings.color_bg }};
      --surface: {{ settings.color_surface }};
      --border: {{ settings.color_border }};
      --text: {{ settings.color_text }};
      --text-muted: {{ settings.color_text_muted }};
      --accent: {{ settings.color_accent }};
      --accent-2: {{ settings.color_accent_2 }};
      --page-width: {{ settings.page_width }}px;
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  {% section 'header' %}
  {% if settings.show_marquee %}{% section 'marquee' %}{% endif %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'newsletter' %}
  {% section 'footer' %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
