<section class="collection-block">
  <div class="wrap">
    <div class="collection-block__head">
      <div>
        <span class="section-tag">{{ collection.products_count }} products</span>
        <h1>{{ collection.title }}</h1>
        {% if collection.description != blank %}<p class="collection-desc">{{ collection.description }}</p>{% endif %}
      </div>
    </div>

    {%- paginate collection.products by 24 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="empty-note">No products in this collection yet.</p>
        {%- endfor -%}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Prev</a>{% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span class="pagination__current">{{ part.title }}</span>{% endif %}
          {% endfor %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}
        </div>
      {% endif %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
