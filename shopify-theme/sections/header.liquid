<header class="site-header">
  <div class="wrap site-header__inner">
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="site-logo">
      {%- if shop.name -%}
        <span class="site-logo__mark">{{ shop.name | slice: 0, 1 }}</span>
        <span class="site-logo__text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" id="siteNav">
      {%- for link in linklists.main-menu.links -%}
        <a href="{{ link.url }}" class="site-nav__link">{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="site-nav__link">All Products</a>
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
        <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}">
      </form>
      <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6L4 2H2"/></svg>
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{ "name": "Header", "settings": [] }
{% endschema %}
