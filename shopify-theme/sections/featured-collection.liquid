<section class="collection-block">
  <div class="wrap">
    <div class="collection-block__head">
      <div>
        <span class="section-tag">{{ section.settings.tag_label }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.collection != blank %}
        <a class="btn btn--outline" href="{{ section.settings.collection.url }}">View all →</a>
      {% endif %}
    </div>

    <div class="product-grid">
      {%- assign col = section.settings.collection -%}
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.product_limit -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="empty-note">No products in this collection yet.</p>
        {%- endfor -%}
      {%- else -%}
        <p class="empty-note">Select a collection in the theme editor.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "tag_label", "label": "Eyebrow label", "default": "TOP PICKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh off the drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
