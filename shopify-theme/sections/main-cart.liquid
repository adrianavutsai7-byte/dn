<section class="cart-page">
  <div class="wrap">
    <h1>{{ 'general.cart.title' | t }}</h1>

    {% if cart.item_count == 0 %}
      <p class="empty-note">{{ 'general.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.cart.continue_shopping' | t }}</a>
    {% else %}
      {% form 'cart', cart %}
        <div class="cart-table">
          {% for item in cart.items %}
            <div class="cart-row">
              <div class="cart-row__media">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
                {% else %}
                  <div class="product-card__placeholder">{{ item.product.title | slice: 0, 1 }}</div>
                {% endif %}
              </div>
              <div class="cart-row__info">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}<span class="cart-row__variant">{{ item.variant.title }}</span>{% endunless %}
                <span class="cart-row__price">{{ item.final_price | money }}</span>
              </div>
              <div class="cart-row__qty">
                <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0">
              </div>
              <div class="cart-row__total">{{ item.final_line_price | money }}</div>
              <a href="{{ item.url_to_remove }}" class="cart-row__remove" aria-label="{{ 'general.cart.remove' | t }}">×</a>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <div class="cart-summary__row">
            <span>{{ 'general.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="update" class="btn btn--outline">Update cart</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--full">{{ 'general.cart.checkout' | t }}</button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
